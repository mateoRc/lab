VAULT_PORT=8080
TELEMETRY_QUEUE_SIZE=1000
VAULT_BUILD_CONTEXT=../vaultsh
ATLAS_BUILD_CONTEXT=../atlas
FORGE_BUILD_CONTEXT=../forge
ORACLE_BUILD_CONTEXT=../oracle
ATLAS_AUTH_TOKEN=
FORGE_AUTH_TOKEN=
ORACLE_AUTH_TOKEN=
# mock | openrouter | groq. Groq's free tier allows 1000 requests/day.
ORACLE_PROVIDER=groq
ORACLE_MODEL=openai/gpt-oss-20b
# OpenRouter-only: ordered rotation list used when ORACLE_PROVIDER=openrouter.
# ORACLE_MODELS=google/gemma-4-26b-a4b-it:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3.5-lightning:free
# Provider API key. Production requires ORACLE_API_KEY; locally the
# provider-specific key below is enough.
ORACLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
FORGE_RETENTION_DAYS=365
FORGE_MAX_DATABASE_BYTES=268435456
DOMAIN=
SESSION_LIMIT=5000
