VAULT_PORT=8080
TELEMETRY_QUEUE_SIZE=1000
VAULT_BUILD_CONTEXT=../vaultsh
ATLAS_BUILD_CONTEXT=../atlas
FORGE_BUILD_CONTEXT=../forge
ORACLE_BUILD_CONTEXT=../oracle
ATLAS_AUTH_TOKEN=
FORGE_AUTH_TOKEN=
ORACLE_AUTH_TOKEN=
# Comma-separated fallback chain, tried left to right: mock | openrouter | groq.
# e.g. groq,openrouter uses Groq's free 1000 requests/day, then OpenRouter.
ORACLE_PROVIDER=groq,openrouter
ORACLE_MODEL=openai/gpt-oss-20b
# OpenRouter-only: ordered rotation list. ORACLE_MODEL overrides only the
# first provider in the chain.
# ORACLE_MODELS=nvidia/nemotron-3.5-lightning:free,dots-studio/dots-3-note-preview:free,liquid/lfm-2.5-2.6b:free
# Provider API key. Production requires ORACLE_API_KEY; locally the
# provider-specific key below is enough.
ORACLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
FORGE_RETENTION_DAYS=365
FORGE_MAX_DATABASE_BYTES=268435456
DOMAIN=
SESSION_LIMIT=5000
